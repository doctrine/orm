<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Doctrine\Tests\ORM\Mapping\UserWithStringOrderBy" table="user_with_string_order">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <one-to-many field="phonenumbersAsc" target-entity="Phonenumber" mapped-by="user">
            <order-by>
                <order-by-field name="number" direction="ASC" />
            </order-by>
        </one-to-many>

        <one-to-many field="phonenumbersDesc" target-entity="Phonenumber" mapped-by="user">
            <order-by>
                <order-by-field name="number" direction="DESC" />
            </order-by>
        </one-to-many>

        <many-to-many field="groupsMixed" target-entity="Group">
            <order-by>
                <order-by-field name="name" direction="ASC" />
                <order-by-field name="id" direction="DESC" />
            </order-by>
        </many-to-many>
    </entity>
</doctrine-mapping>
